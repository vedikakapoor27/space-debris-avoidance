# Copy this file to .env and change the secrets before running Docker / production.
#   cp .env.example .env

FLASK_ENV=production

# Generate strong values, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

POSTGRES_USER=astraeus
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=astraeus_db

# Used by the backend container (hostnames match docker-compose service names)
DATABASE_URL=postgresql://astraeus:change-me-db-password@db:5432/astraeus_db
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80

MODEL_PATH=collision_model.pkl
